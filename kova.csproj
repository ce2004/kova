<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Kova</AssemblyName>
    <RootNamespace>TailRemote</RootNamespace>
    <!-- Called Kova since 2.3.0. The code keeps its TailRemote namespace (nothing outside sees it); embedded files have fixed names (LogicalName), so they do not depend on the assembly name. -->
    <Product>Kova</Product>
    <AssemblyTitle>Kova</AssemblyTitle>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- Desktop Duplication and Media Foundation are called through their COM tables (Dxgi.cs, H264.cs) -->
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>4.2.0</Version>
    <!-- ARM64 by default; "dotnet publish -r win-x64" builds the x64 copy. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- One self-contained file, so a fresh cloud PC needs no .NET install. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Size: the bundled .NET runtime is most of the exe. Trimming drops the parts TailRemote
         never uses (75 MB down to about 31), and ReadyToRun is off: it nearly doubled the code
         for a slightly quicker start. WinForms is not officially trim-safe, so the self-test and
         the window are checked after every change to this. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Trimming keeps all of TailRemote's own code: its Windows audio and COM declarations are only reached by Windows itself. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="Kova" />
    <!-- WinForms reaches much of itself through COM (drag and drop, accessibility): trimmed, the window crashed on opening. -->
    <TrimmerRootAssembly Include="System.Windows.Forms" />
    <TrimmerRootAssembly Include="System.Windows.Forms.Primitives" />
    <TrimmerRootAssembly Include="System.Drawing.Common" />
    <TrimmerRootAssembly Include="Accessibility" />
    <TrimmerRootDescriptor Include="TrimRoots.xml" />
  </ItemGroup>

  <!-- The NVDA controller client must match this process's architecture. -->
  <ItemGroup>
    <None Include="native\win-arm64\nvdaControllerClientArm64.dll" Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>nvdaControllerClientArm64.dll</Link>
    </None>
    <None Include="native\win-x64\nvdaControllerClient64.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>nvdaControllerClient64.dll</Link>
    </None>
    <EmbeddedResource Include="native\NVDA-controllerClient-LICENSE.txt">
      <LogicalName>NVDA-controllerClient-LICENSE.txt</LogicalName>
    </EmbeddedResource>
    <!-- Event sounds (Opus): see native\Sounds-CREDITS.txt for where each comes from. -->
    <EmbeddedResource Include="native\sounds\*.opus">
      <LogicalName>snd.%(Filename).opus</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="native\Sounds-CREDITS.txt">
      <LogicalName>Sounds-CREDITS.txt</LogicalName>
    </EmbeddedResource>
    <!-- About, View the changelog and Read the guide show these. -->
    <EmbeddedResource Include="CHANGES.txt">
      <LogicalName>CHANGES.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="README.txt">
      <LogicalName>README.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="native\Concentus-LICENSE.txt">
      <LogicalName>Concentus-LICENSE.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

</Project>
